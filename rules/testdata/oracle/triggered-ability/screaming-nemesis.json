        {"op": "resolve", "targets": ["p1"]},
        {"op": "pass_to", "step": "main1", "active": "p1"},
        {"op": "cast", "seat": 1, "card": "p1:Revitalize", "mana": "CW"},
        {"op": "resolve"}
