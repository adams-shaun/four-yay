     "keywords": [
      "Flying"
     ],
     "types": [
      "Creature",
      "Insect"
     ]
    },
    {
     "count": {
      "seat": 1,
      "zone": "battlefield",
      "name": "Insect"
     },
     "eq": 0
    }
   ]
  },
