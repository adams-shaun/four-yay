        "p1": {}
      },
      "steps": [
        {"op": "play", "seat": 0, "card": "p0:Blooming Marsh"}
      ],
      "expect": [
        {"card": "p0:Blooming Marsh", "zone": "battlefield", "tapped": true}
      ]
    },
    {
      "name": "opponent-lands-do-not-count",
      "cr": ["614.1c"],
      "why": "Only lands YOU control count: seat 1's three lands do not make seat 0's Marsh (with one other land) enter tapped.",
      "setup": {
        "p0": {"hand": ["Blooming Marsh"], "battlefield": ["Swamp"]},
        "p1": {"battlefield": ["Swamp", "Swamp", "Swamp"]}
      },
      "steps": [
        {"op": "play", "seat": 0, "card": "p0:Blooming Marsh"}
      ],
      "expect": [
