      "setup": {
        "p0": {"hand": ["Gift of Immortality"], "battlefield": ["Grizzly Bears"]},
        "p1": {}
      },
      "steps": [
        {"op": "cast", "seat": 0, "card": "p0:Gift of Immortality", "mana": "WWW", "targets": ["p0:Grizzly Bears"]},
        {"op": "resolve"},
        {"op": "move", "seat": 0, "card": "p0:Grizzly Bears", "to": "graveyard",
         "expect": [{"trigger_on_stack": "p0:Gift of Immortality", "want": true}]},
        {"op": "resolve"}
