      "expect": [
        {"card": "p0:Grizzly Bears", "zone": "battlefield"}
      ]
    },
    {
      "name": "aura-returns-attached-at-end-step",
      "cr": ["603.6a", "610.3", "513.1"],
      "why": "After the creature returns, the delayed trigger returns Gift of Immortality to the battlefield attached to that creature at the beginning of the next end step.",
      "setup": {
        "p0": {"hand": ["Gift of Immortality"], "battlefield": ["Grizzly Bears"]},
        "p1": {}
      },
      "steps": [
        {"op": "cast", "seat": 0, "card": "p0:Gift of Immortality", "mana": "WWW", "targets": ["p0:Grizzly Bears"]},
        {"op": "resolve"},
        {"op": "move", "seat": 0, "card": "p0:Grizzly Bears", "to": "graveyard"},
        {"op": "resolve"},
        {"op": "pass_to", "step": "end"},
        {"op": "resolve"}
