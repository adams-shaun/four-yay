{
  "card": "Chittering Dispatcher",
  "family": "etb-ltb",
  "oracle_sha": "896435b81fc1",
  "author": "cli-20260929T235020Z-c90601c7 (Oracle + CR only)",
  "scenarios": [
    {
      "name": "leaves-battlefield-creates-spawn",
      "cr": ["603.6c", "111.1"],
      "why": "Chittering Dispatcher's leaves-the-battlefield trigger creates a 0/1 colorless Eldrazi Spawn token when it leaves the battlefield, so a destroyed Dispatcher leaves the token behind.",
      "setup": {
        "p0": {"battlefield": ["Chittering Dispatcher"]},
        "p1": {}
      },
      "steps": [
        {"op": "move", "seat": 0, "card": "p0:Chittering Dispatcher", "to": "graveyard",
         "expect": [{"trigger_on_stack": "p0:Chittering Dispatcher", "want": true}]},
        {"op": "resolve"}
      ],
      "expect": [
        {"card": "p0:Chittering Dispatcher", "zone": "graveyard"},
        {"count": {"seat": 0, "zone": "battlefield", "name": "Eldrazi Spawn", "token": true}, "eq": 1},
        {"card": "p0:token:Eldrazi Spawn", "pt": "0/1"}
      ]
    },
    {
      "name": "exile-also-creates-spawn",
      "cr": ["603.6c", "603.6e"],
      "why": "The trigger is 'leaves the battlefield', which includes exile; exiling the Dispatcher still creates the Spawn.",
      "setup": {
        "p0": {"battlefield": ["Chittering Dispatcher"]},
        "p1": {}
      },
      "steps": [
        {"op": "move", "seat": 0, "card": "p0:Chittering Dispatcher", "to": "exile"},
        {"op": "resolve"}
      ],
      "expect": [
        {"card": "p0:Chittering Dispatcher", "zone": "exile"},
        {"count": {"seat": 0, "zone": "battlefield", "name": "Eldrazi Spawn", "token": true}, "eq": 1}
      ]
    }
  ]
}
