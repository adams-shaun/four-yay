        {"op": "pass_to", "seat": 1, "decision": "blockers",
         "expect": [
           {"can_block": {"blocker": "p1:Forsaken Miner", "attacker": "p0:Grizzly Bears"}, "want": false},
           {"can_block": {"blocker": "p1:Grizzly Bears", "attacker": "p0:Grizzly Bears"}, "want": true}
         ]},
        {"op": "pass_to", "seat": 0, "step": "end"}
      ],
      "expect": [
        {"life": {"p1": 18}}
      ]
    }
  ]
