      "steps": [
        {"op": "attack", "seat": 0, "attackers": ["p0:Steel Leaf Champion"], "defender": "p1"},
        {"op": "pass_to", "decision": "blockers"}
      ],
      "expect": [
        {"can_block": {"blocker": "p1:Grizzly Bears", "attacker": "p0:Steel Leaf Champion"}, "want": false},
        {"can_block": {"blocker": "p1:Centaur Courser", "attacker": "p0:Steel Leaf Champion"}, "want": true}
      ]
    }
  ]
