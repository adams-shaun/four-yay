#!/bin/sh
# Reject commit messages carrying AI-attribution trailers (repo rule, 2026-09-05).
if grep -Eiq '^(Co-Authored-By:|Signed-off-by:.*(claude|anthropic)|.*Generated with .*Claude)' "$1"; then
	echo "commit-msg: attribution trailer found; remove Co-Authored-By / 'Generated with' lines" >&2
	exit 1
fi

# gorge uses no issue-tracker trailers or references. Agent seats share a
# global memory written for other repos whose mandatory "Ref:" rule leaked into
# commits here (fb-20260914T120016Z-86135e20). The pattern spells the tracker's
# name as [j]ira so this hook's own text never matches it.
if grep -Eiq '^Ref:|[j]ira' "$1"; then
	echo "commit-msg: issue-tracker reference found; gorge commit messages carry none — remove it" >&2
	exit 1
fi

exit 0
